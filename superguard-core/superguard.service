# SuperGuard Core - Systemd Service (Ubuntu/Linux)

[Unit]
Description=SuperGuard Alarm Core API
Documentation=https://github.com/yourorg/superguard
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
User=superguard
Group=superguard
WorkingDirectory=/opt/superguard
Environment=SG_DATABASE_URL=postgresql+asyncpg://superguard:superguard123@localhost:5432/superguard
Environment=SG_REDIS_URL=redis://localhost:6379/0
Environment=SG_STORAGE_PATH=/var/lib/superguard/storage
Environment=SG_HOST=0.0.0.0
Environment=SG_PORT=8000
Environment=SG_DEBUG=false
Environment=SG_LOG_LEVEL=INFO
Environment=SG_SECRET_KEY=your-secret-key-here
Environment=SG_JWT_PRIVATE_KEY=/etc/superguard/jwt_private.pem
Environment=SG_JWT_PUBLIC_KEY=/etc/superguard/jwt_public.pem
ExecStart=/opt/superguard/venv/bin/uvicorn superguard_core.main:app --host 0.0.0.0 --port 8000 --workers 4
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/superguard /var/log/superguard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=superguard

[Install]
WantedBy=multi-user.target