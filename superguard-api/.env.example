# SuperGuard API Configuration
# Copy to .env and fill in values

# Application
APP_NAME=SuperGuard API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8080
WORKERS=2

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./superguard.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/superguard

# Redis (for WebSocket pub/sub, caching, rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-strong-random-key
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://dashboard.stmaria.org"]

# MediaMTX
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_WEBRTC_URL=webrtc://localhost:8554
MEDIAMTX_HLS_URL=http://localhost:8888

# Tuya Cloud (for actuator sync)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_REGION=eu

# MQTT (Home Assistant, etc.)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=superguard

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/superguard-api.log

# Telemetry
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=superguard-api

# Backup
BACKUP_DIR=./backups
BACKUP_SCHEDULE=0 3 * * *