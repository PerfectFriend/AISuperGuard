# SuperGuard Alarm — config (DO NOT COMMIT REAL VALUES!)
# Copy to sguard.env and fill in your values

# Telegram Bot Token (create via @BotFather, SEPARATE from any Hermes gateway bot!)
SG_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Telegram Chat ID (user or group, get via @userinfobot)
SG_CHAT_ID=143293811

# Tuya Smart Plug IP (local network, e.g. 192.168.x.x)
SG_PLUG_IP=192.168.137.109

# Tuya Plug Local Key (32 hex chars, from Tuya IoT platform or device config)
SG_PLUG_KEY=YOUR_LOCAL_KEY_HERE